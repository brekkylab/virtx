diff --git a/src/venus/vkr_device_memory.c b/src/venus/vkr_device_memory.c
--- a/src/venus/vkr_device_memory.c
+++ b/src/venus/vkr_device_memory.c
@@ -17,6 +17,109 @@
 #include "vkr_metal_helpers.h"
 #include "vkr_physical_device.h"
 
+#ifndef _WIN32
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include "util/anon_file.h"
+#endif
+
+/* shm a VkDeviceMemory is imported from as a host pointer -- see
+ * vkr_physical_device::use_host_memory_import. It has to outlive the memory.
+ */
+struct vkr_host_shm {
+   int fd;
+   void *ptr;
+   size_t size;
+};
+
+static void
+vkr_host_shm_free(struct vkr_host_shm *shm)
+{
+   if (!shm)
+      return;
+#ifndef _WIN32
+   munmap(shm->ptr, shm->size);
+   close(shm->fd);
+#endif
+   free(shm);
+}
+
+/* Free the shm a VkDeviceMemory was imported from, once the memory itself is gone -- a host
+ * allocation has to outlive the VkDeviceMemory imported from it. Not in
+ * vkr_device_memory_release, which vkFreeMemory calls before the memory is freed: called by
+ * vkr_device_remove_object, which every path reaches after it.
+ */
+void
+vkr_device_memory_free_host_shm(struct vkr_device_memory *mem)
+{
+   vkr_host_shm_free(mem->host_shm);
+   mem->host_shm = NULL;
+}
+
+/* Allocate shm for a VkDeviceMemory of mem_type_index and fill *import to import it, or
+ * answer NULL if this memory cannot be backed so -- a type no host pointer can back, or no
+ * shm -- for the caller to allocate it as it would have otherwise.
+ */
+static struct vkr_host_shm *
+vkr_host_shm_alloc(struct vkr_device *dev,
+                   VkDeviceSize size,
+                   uint32_t mem_type_index,
+                   VkImportMemoryHostPointerInfoEXT *import)
+{
+#ifdef _WIN32
+   (void)dev;
+   (void)size;
+   (void)mem_type_index;
+   (void)import;
+   return NULL;
+#else
+   /* Not in venus's proc table: venus does not carry the extension to the guest. */
+   PFN_vkGetMemoryHostPointerPropertiesEXT get_props =
+      (PFN_vkGetMemoryHostPointerPropertiesEXT)dev->physical_device->proc_table
+         .GetDeviceProcAddr(dev->base.handle.device, "vkGetMemoryHostPointerPropertiesEXT");
+   if (!get_props)
+      return NULL;
+
+   const VkDeviceSize alignment = dev->physical_device->host_pointer_alignment;
+   const size_t shm_size = (size + alignment - 1) / alignment * alignment;
+
+   struct vkr_host_shm *shm = calloc(1, sizeof(*shm));
+   if (!shm)
+      return NULL;
+   shm->fd = os_create_anonymous_file(shm_size, "vkr-host-mem");
+   if (shm->fd < 0) {
+      free(shm);
+      return NULL;
+   }
+   shm->ptr = mmap(NULL, shm_size, PROT_READ | PROT_WRITE, MAP_SHARED, shm->fd, 0);
+   if (shm->ptr == MAP_FAILED) {
+      close(shm->fd);
+      free(shm);
+      return NULL;
+   }
+   shm->size = shm_size;
+
+   VkMemoryHostPointerPropertiesEXT props = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_HOST_POINTER_PROPERTIES_EXT,
+   };
+   if (get_props(dev->base.handle.device,
+                 VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT, shm->ptr,
+                 &props) != VK_SUCCESS ||
+       !(props.memoryTypeBits & (1u << mem_type_index))) {
+      vkr_host_shm_free(shm);
+      return NULL;
+   }
+
+   *import = (VkImportMemoryHostPointerInfoEXT){
+      .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+      .pHostPointer = shm->ptr,
+   };
+   return shm;
+#endif
+}
