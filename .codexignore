# What an agent client should not pull into context when it loads this plugin: everything here is
# built, downloaded, or local to one machine. Mirrors .gitignore, minus the entries git alone
# cares about.

# Rust build output, which is most of the checkout by size.
target/
**/mutants.out*/

# Built bindings: the Node addon and the Python extension, and their installed dependencies.
*.node
*.so
node_modules/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
dist/
build/

# Written by the release workflow; a checkout has none.
virtx-uvm.version

# Local data, secrets, and scratch.
/data
.env
.claude/
.omc/
.remember

# Editor / OS cruft.
.DS_Store
.idea/
.vscode/
*.swp
