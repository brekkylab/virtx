+VkResult MVKPhysicalDevice::getCooperativeMatrixProperties(uint32_t* pPropertyCount, VkCooperativeMatrixPropertiesKHR* pProperties) {
+	static const struct { uint32_t size; VkComponentTypeKHR ab, cr; } combos[] = {
+		{ 8,  VK_COMPONENT_TYPE_BFLOAT16_KHR, VK_COMPONENT_TYPE_FLOAT32_KHR },
+		{ 16, VK_COMPONENT_TYPE_BFLOAT16_KHR, VK_COMPONENT_TYPE_FLOAT32_KHR },
+		{ 8,  VK_COMPONENT_TYPE_FLOAT16_KHR, VK_COMPONENT_TYPE_FLOAT16_KHR },
+		{ 8,  VK_COMPONENT_TYPE_FLOAT16_KHR, VK_COMPONENT_TYPE_FLOAT32_KHR },
+		{ 8,  VK_COMPONENT_TYPE_FLOAT32_KHR, VK_COMPONENT_TYPE_FLOAT32_KHR },
+		{ 16, VK_COMPONENT_TYPE_FLOAT16_KHR, VK_COMPONENT_TYPE_FLOAT16_KHR },
+		{ 16, VK_COMPONENT_TYPE_FLOAT16_KHR, VK_COMPONENT_TYPE_FLOAT32_KHR },
+		{ 16, VK_COMPONENT_TYPE_FLOAT32_KHR, VK_COMPONENT_TYPE_FLOAT32_KHR },
+	};
+	uint32_t first = supportsBFloat16() ? 0 : 2;
+	uint32_t count = supportsCooperativeMatrix() ? (uint32_t)std::size(combos) - first : 0;
+	if ( !pProperties ) {
+		*pPropertyCount = count;
+		return VK_SUCCESS;
+	}
+	uint32_t written = min(*pPropertyCount, count);
+	for (uint32_t n = 0; n < written; n++) {
+		uint32_t i = first + n;
+		auto& p = pProperties[n];
+		p.MSize = combos[i].size;
+		p.NSize = combos[i].size;
+		p.KSize = combos[i].size;
+		p.AType = combos[i].ab;
+		p.BType = combos[i].ab;
+		p.CType = combos[i].cr;
+		p.ResultType = combos[i].cr;
+		p.saturatingAccumulation = VK_FALSE;
+		p.scope = VK_SCOPE_SUBGROUP_KHR;
+	}
+	*pPropertyCount = written;
+	return written < count ? VK_INCOMPLETE : VK_SUCCESS;
+}
+
+bool MVKPhysicalDevice::supportsBFloat16() {
+	return _metalFeatures.mslVersion >= SPIRV_CROSS_NAMESPACE::CompilerMSL::Options::make_msl_version(3, 1) && supportsMTLGPUFamily(Apple7);
+}
+
+bool MVKPhysicalDevice::supportsCooperativeMatrix() {
+	return _metalFeatures.mslVersion >= SPIRV_CROSS_NAMESPACE::CompilerMSL::Options::make_msl_version(3, 1) && supportsMTLGPUFamily(Apple7);
+}
