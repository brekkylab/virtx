+if cc.get_argument_syntax() == 'msvc'
+   # Tells virglrenderer.h to mark the public API dllexport rather than
+   # dllimport. Project-wide, not just on the library target: the static
+   # libvirgl that gets linked into it includes the same header.
+   add_project_arguments('-DVIRGL_RENDERER_BUILD', language : 'c')
+endif
+
 inc_configuration = include_directories(['.', 'src'])
 
 with_fuzzer = get_option('fuzzer')
