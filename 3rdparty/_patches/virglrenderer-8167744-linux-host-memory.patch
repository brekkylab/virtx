+/* Back host-visible memory with shm, where nothing the device exports can be mapped.
+ *
+ * A blob the guest maps is mapped on the host from the fd its memory exports, and a host
+ * can mmap a dma_buf or a shm fd but not an opaque fd. A device that exports only opaque
+ * fds -- NVIDIA's -- therefore has host-visible memory no guest can map: vkMapMemory fails
+ * in the guest with VK_ERROR_MEMORY_MAP_FAILED. Such a device can usually take a host
+ * allocation instead (VK_EXT_external_memory_host), so the memory is allocated as shm,
+ * imported as a host pointer, and exported as the shm -- what macOS does with Metal
+ * buffers, and with the same fd type.
+ *
+ * A host pointer is system memory, so it can back only the memory types that are. A type
+ * that is both device-local and host-visible -- resizable BAR -- is reported device-local
+ * only: left host-visible, a guest that picks it for a mapping gets memory no host path
+ * can map.
+ */
 static void
+vkr_physical_device_init_host_memory_import(struct vkr_physical_device *physical_dev)
+{
+#ifdef _WIN32
+   /* The Windows build maps nothing through an fd; see vkr_host_shm_alloc. */
+   (void)physical_dev;
+#else
+   if (!physical_dev->EXT_external_memory_host || physical_dev->EXT_external_memory_metal ||
+       physical_dev->is_dma_buf_fd_export_supported || physical_dev->gbm_device ||
+       physical_dev->udmabuf_dev_fd >= 0)
+      return;
+
+   struct vn_physical_device_proc_table *vk = &physical_dev->proc_table;
+   VkPhysicalDeviceExternalMemoryHostPropertiesEXT host_props = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_MEMORY_HOST_PROPERTIES_EXT,
+   };
+   VkPhysicalDeviceProperties2 props2 = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2,
+      .pNext = &host_props,
+   };
+   vk->GetPhysicalDeviceProperties2(physical_dev->base.handle.physical_device, &props2);
+
+   /* shm is mapped at page granularity, and an alignment past that is one this cannot
+    * meet without over-allocating every mapping. */
+   const VkDeviceSize page_size = getpagesize();
+   if (!host_props.minImportedHostPointerAlignment ||
+       host_props.minImportedHostPointerAlignment > page_size ||
+       page_size % host_props.minImportedHostPointerAlignment)
+      return;
+
+   physical_dev->use_host_memory_import = true;
+   physical_dev->host_pointer_alignment = page_size;
+
+   VkPhysicalDeviceMemoryProperties *props = &physical_dev->memory_properties;
+   const VkMemoryPropertyFlags host_bits = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                                           VK_MEMORY_PROPERTY_HOST_COHERENT_BIT |
+                                           VK_MEMORY_PROPERTY_HOST_CACHED_BIT;
+   for (uint32_t i = 0; i < props->memoryTypeCount; i++) {
+      VkMemoryPropertyFlags *flags = &props->memoryTypes[i].propertyFlags;
+      if ((*flags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) &&
+          (*flags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT))
+         *flags &= ~host_bits;
+   }
+#endif
+}
