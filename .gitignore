/target
# Local microVM assets (rootfs, kernels) — large, machine-specific, not committed.
/data

# rustfmt backups
**/*.rs.bk

# MSVC debug info
*.pdb

# cargo mutants
**/mutants.out*/

# rustc ICE dumps
rustc-ice-*.txt

# Editor / OS
.DS_Store
*.swp

# Local tooling
.claude
.omc
.remember

# Generated docs write-ups (not versioned)
docs/

# Provider keys for tests and binaries that call a model; credentials never go in the tree.
.env

# Python bytecode
__pycache__/

# Written by the workflow that packs the crate -- see `pin_server` in build.rs.
/virtx-stdio.version

# The server's build: `virtx-abins/` and `virtx-stdio-guest/` are workspaces of their own and so
# build into target directories of their own, with lockfiles of their own.
target/
virtx-abins/Cargo.lock
virtx-stdio-guest/Cargo.lock
# What `cargo xtask build` and `cargo xtask install` write: the dependencies and kernel built
# from `3rdparty/`, and a staged install.
/build
/install
