+            let (parent, name) = location.as_ref().ok_or_else(enoent)?;
+            names.push(name.to_bytes().to_vec());
+            current = *parent;
+        }
+
+        let mut path = self.cfg.root_dir.trim_end_matches('/').as_bytes().to_vec();
+        for name in names.iter().rev() {
+            path.push(b'/');
+            path.extend_from_slice(name);
+        }
+        if path.is_empty() {
+            path.push(b'/');
+        }
+        CString::new(path).map_err(|_| einval())
+    }
