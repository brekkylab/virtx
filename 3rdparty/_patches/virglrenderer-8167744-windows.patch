diff --git a/src/win32_compat.c b/src/win32_compat.c
new file mode 100644
index 0000000..c23b0e8
--- /dev/null
+++ b/src/win32_compat.c
@@ -0,0 +1,78 @@
+/**************************************************************************
+ *
+ * The POSIX calls from win32_compat.h that are more than a rename.
+ *
+ **************************************************************************/
+#include <windows.h>
+
+#include "win32_compat.h"
+
+/* FILETIME counts 100ns ticks from 1601-01-01; the Unix epoch is this far in. */
+#define FILETIME_UNIX_EPOCH_DIFF 116444736000000000ull
+#define FILETIME_TICKS_PER_SEC 10000000ull
+#define NSEC_PER_SEC 1000000000ull
+
+int
+clock_gettime(int clk_id, struct timespec *tp)
+{
+   if (clk_id == CLOCK_MONOTONIC) {
+      /* The performance counter is the only monotonic clock here. Its
+       * frequency is fixed at boot, so reading it once is enough. */
+      static LARGE_INTEGER freq;
+      LARGE_INTEGER now;
+
+      if (!freq.QuadPart && !QueryPerformanceFrequency(&freq))
+         return -1;
+
+      QueryPerformanceCounter(&now);
+
+      tp->tv_sec = (time_t)(now.QuadPart / freq.QuadPart);
+      tp->tv_nsec =
+         (long)(((now.QuadPart % freq.QuadPart) * (LONGLONG)NSEC_PER_SEC) / freq.QuadPart);
+      return 0;
+   }
+
+   if (clk_id == CLOCK_REALTIME) {
+      FILETIME ft;
+      ULARGE_INTEGER ticks;
+
+      GetSystemTimePreciseAsFileTime(&ft);
+      ticks.LowPart = ft.dwLowDateTime;
+      ticks.HighPart = ft.dwHighDateTime;
+      ticks.QuadPart -= FILETIME_UNIX_EPOCH_DIFF;
+
+      tp->tv_sec = (time_t)(ticks.QuadPart / FILETIME_TICKS_PER_SEC);
+      tp->tv_nsec = (long)((ticks.QuadPart % FILETIME_TICKS_PER_SEC) * 100);
+      return 0;
+   }
+
+   return -1;
+}
+
+bool
+win32_thread_is_current(void *thread_handle)
+{
+   return GetThreadId((HANDLE)thread_handle) == GetCurrentThreadId();
+}
+
+int
+nanosleep(const struct timespec *req, struct timespec *rem)
+{
+   /* Sleep() has millisecond resolution and rounds down, so a sub-millisecond
+    * request would not sleep at all. Callers here use this to yield, so round
+    * any non-zero request up to 1ms rather than spin. */
+   DWORD ms = (DWORD)(req->tv_sec * 1000 + req->tv_nsec / 1000000);
+
+   if (!ms && (req->tv_sec || req->tv_nsec))
+      ms = 1;
+
+   Sleep(ms);
+
+   /* Sleep is not interruptible by a signal, so nothing ever remains. */
+   if (rem) {
+      rem->tv_sec = 0;
+      rem->tv_nsec = 0;
+   }
+
+   return 0;
+}
diff --git a/src/win32_compat.h b/src/win32_compat.h
new file mode 100644
index 0000000..8ddcdc7
--- /dev/null
+++ b/src/win32_compat.h
@@ -0,0 +1,61 @@
+/**************************************************************************
+ *
+ * Stand-ins for the POSIX headers this code reaches for, on the one host
+ * that has none of them.
+ *
+ * Every other supported host is POSIX enough that <unistd.h>, <sys/mman.h>
+ * and friends simply exist -- macOS included, which is why none of this was
+ * needed before. Windows has the same handful of calls under different names
+ * in <io.h> and <process.h>, so the mapping is mechanical.
+ *
+ * Only the names this tree actually uses are mapped. Adding more is fine;
+ * mapping names the tree does not use is not, because these are macros and
+ * they will rewrite any identifier that happens to match.
+ *
+ **************************************************************************/
+#ifndef WIN32_COMPAT_H
+#define WIN32_COMPAT_H
+
+#ifndef _WIN32
+#error "win32_compat.h is for Windows hosts only"
+#endif
+
+#include <basetsd.h>
+#include <io.h>
+#include <process.h>
+#include <stdbool.h>
+#include <time.h>
+
+#include "mman_win32.h"
+
+#ifndef _SSIZE_T_DEFINED
+#define _SSIZE_T_DEFINED
+typedef SSIZE_T ssize_t;
+#endif
+
+/* <unistd.h> */
+#define close _close
+#define dup _dup
+#define read _read
+#define write _write
+#define lseek _lseeki64
+#define getpid _getpid
+
+/* <string.h>: the Windows spelling of the reentrant tokeniser. Same contract,
+ * and the third argument is a context pointer either way. */
+#define strtok_r strtok_s
+
+/* <time.h>: POSIX clocks. Only the two ids this tree asks for. */
+#define CLOCK_REALTIME 0
+#define CLOCK_MONOTONIC 1
+
+int clock_gettime(int clk_id, struct timespec *tp);
+int nanosleep(const struct timespec *req, struct timespec *rem);
+
+/* mesa's C11 threads shim leaves thrd_current() disabled on Windows, and says
+ * why: GetCurrentThread() hands back a pseudo-handle that cannot be compared
+ * with the handle thrd_create() returned. Only the thread ids compare, so a
+ * caller that wants "am I that thread?" has to ask it that way. */
+bool win32_thread_is_current(void *thread_handle);
+
+#endif /* WIN32_COMPAT_H */
