From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: grf53 <grf0503@gmail.com>
Date: Thu, 5 Nov 2026 14:22:21 +0900
Subject: heap-limit: venus caps every heap and budget the guest sees at VKR_HEAP_SIZE_MAX

## Why virtx needs it

A guest maps every host-visible allocation through one window of guest-physical addresses, so the window is all its GPU can hold at once, whatever the host device reports.
virtx-uvm sets VKR_HEAP_SIZE_MAX to the window's size (virtx-uvm/src/machine/gpu.rs), and a guest program sizes itself to that rather than to the host's heap and a vkMapMemory that fails.

## What it changes

The guest maps every host-visible allocation through one window of guest-physical addresses,
so the window is all the guest's GPU can hold at once
(`machine/gpu.rs` (virtx-uvm/src/machine/gpu.rs)). venus reported the host device's
heaps, 19 GB on an 18 GB Mac, and a guest program sized itself to that, then failed a
`vkMapMemory` past the window; ncnn went on to copy out of the null pointer it got back.

With the patch venus caps every heap it reports, and each budget of `VK_EXT_memory_budget`,
at `VKR_HEAP_SIZE_MAX` bytes, read once from the environment; unset or `0` caps nothing.
`virtx-uvm` sets it to the window before the render server starts. It touches only
`src/venus/vkr_physical_device.c`.

## When it can go

When upstream caps a heap at a size in bytes.
VKR_HEAP_MEMORY_PERCENT does not stand in for it: it is one share for every heap, which takes knowing the host's heap sizes to set, and it hides VK_EXT_memory_budget from the guest rather than capping its budgets.
---
 src/venus/vkr_physical_device.c | 49 +++++++++++++++++++++++++++++++++
 1 file changed, 49 insertions(+)

diff --git a/src/venus/vkr_physical_device.c b/src/venus/vkr_physical_device.c
index d4a128ed..e67f716c 100644
--- a/src/venus/vkr_physical_device.c
+++ b/src/venus/vkr_physical_device.c
@@ -5,6 +5,8 @@
 
 #include "vkr_physical_device.h"
 
+#include <stdlib.h>
+
 #include "vn_protocol_renderer_device.h"
 
 #include "vkr_context.h"
@@ -178,6 +180,40 @@ vkr_physical_device_init_extra_properties(struct vkr_physical_device *physical_d
    vk->GetPhysicalDeviceProperties2(handle, &props2);
 }
 
+/* The most memory any heap is reported to hold, in bytes, or 0 for no limit.
+ *
+ * Set by the embedder in VKR_HEAP_SIZE_MAX when what it can back is less than
+ * what the host device has -- a guest that maps its host-visible memory
+ * through a window of guest-physical addresses can hold no more than that
+ * window, whatever the device underneath reports. Reporting the smaller size
+ * is what lets a guest program size itself to what it can have, rather than
+ * find out at the vkMapMemory that fails.
+ */
+static VkDeviceSize
+vkr_heap_size_max(void)
+{
+   static VkDeviceSize max;
+   static bool read;
+   if (!read) {
+      const char *env = getenv("VKR_HEAP_SIZE_MAX");
+      max = env ? strtoull(env, NULL, 0) : 0;
+      read = true;
+   }
+   return max;
+}
+
+static void
+vkr_clamp_memory_heaps(VkPhysicalDeviceMemoryProperties *props)
+{
+   const VkDeviceSize max = vkr_heap_size_max();
+   if (!max)
+      return;
+   for (uint32_t i = 0; i < props->memoryHeapCount; i++) {
+      if (props->memoryHeaps[i].size > max)
+         props->memoryHeaps[i].size = max;
+   }
+}
+
 static void
 vkr_physical_device_init_memory_properties(struct vkr_physical_device *physical_dev)
 {
@@ -185,6 +221,7 @@ vkr_physical_device_init_memory_properties(struct vkr_physical_device *physical_
 
    VkPhysicalDevice handle = physical_dev->base.handle.physical_device;
    vk->GetPhysicalDeviceMemoryProperties(handle, &physical_dev->memory_properties);
+   vkr_clamp_memory_heaps(&physical_dev->memory_properties);
 
    if (!VKR_DEBUG(NO_MEM_TYPE_SPOOF)) {
       VkPhysicalDeviceMemoryProperties *p = &physical_dev->memory_properties;
@@ -767,6 +804,18 @@ vkr_dispatch_vkGetPhysicalDeviceMemoryProperties2(
       vn_replace_vkGetPhysicalDeviceMemoryProperties2_args_handle(args);
       vk->GetPhysicalDeviceMemoryProperties2(args->physicalDevice,
                                              args->pMemoryProperties);
+
+      /* A budget is at most the heap it is of. */
+      const VkDeviceSize max = vkr_heap_size_max();
+      for (VkBaseOutStructure *s = args->pMemoryProperties->pNext; max && s; s = s->pNext) {
+         if (s->sType != VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_BUDGET_PROPERTIES_EXT)
+            continue;
+         VkPhysicalDeviceMemoryBudgetPropertiesEXT *budget = (void *)s;
+         for (uint32_t i = 0; i < VK_MAX_MEMORY_HEAPS; i++) {
+            if (budget->heapBudget[i] > max)
+               budget->heapBudget[i] = max;
+         }
+      }
    }
 
    /* VkPhysicalDeviceMemoryProperties is invariant. Always return the cached
