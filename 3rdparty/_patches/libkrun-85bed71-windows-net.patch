diff --git a/src/libkrun/src/api/device_builders.rs b/src/libkrun/src/api/device_builders.rs
--- a/src/libkrun/src/api/device_builders.rs
+++ b/src/libkrun/src/api/device_builders.rs
@@ -1468,11 +1468,17 @@ impl NetDevice {
         flags: NetFlags,
     ) -> Result<Self, VmmError> {
         use devices::virtio::net::device::VirtioNetBackend;
-        use std::os::windows::io::RawSocket;
+        use std::os::windows::io::{IntoRawHandle, RawSocket};
         let _ = flags;
+        // `into_raw_handle` and not `as_raw_handle`: the handle is taken by value, so
+        // borrowing it here leaves the `OwnedHandle` to be dropped at the end of this
+        // function -- closing the socket the backend has just been handed the number of.
+        // Activation then finds a handle that is closed, or reused by something that is not
+        // a socket, and `ioctlsocket` answers `WSAEOPNOTSUPP`. The `OwnedFd` builders above
+        // give up ownership the same way, which is the contract a caller is written against.
         Self::new_inner(
             id,
-            VirtioNetBackend::UnixstreamFd(handle.as_raw_handle() as RawSocket),
+            VirtioNetBackend::UnixstreamFd(handle.into_raw_handle() as RawSocket),
             mac,
             features,
         )
