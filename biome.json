{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "virtx-node/*.js",
      "virtx-node/*.d.ts",
      "virtx-node/__test__/*.mjs",
      "scripts/packages/**/*.mjs"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "overrides": [
    {
      "includes": ["virtx-node/*.js"],
      "linter": { "rules": { "suspicious": { "noRedundantUseStrict": "off" } } }
    }
  ]
}
