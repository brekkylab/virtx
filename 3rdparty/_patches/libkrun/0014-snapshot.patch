@@ -0,0 +1,70 @@
+//! What a virtio device's transport is, saved at a quiescent point and set again on a fresh
+//! device, so that a restored guest finds its devices where it left them without negotiating
+//! them again.
+//!
+//! A queue is saved as the driver configured it. Its device's place in it is not: at a quiescent
+//! point the device has used everything it took, so on restore both of its indices are the used
+//! ring's own index, read from the restored memory.
+
+use std::num::Wrapping;
+
+use vm_memory::{Bytes, GuestAddress, GuestMemoryMmap};
+
+use super::Queue;
+
+/// A queue as its driver configured it.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct QueueSnapshot {
+    pub size: u16,
+    pub ready: bool,
+    pub desc_table: u64,
+    pub avail_ring: u64,
+    pub used_ring: u64,
+}
+
+impl QueueSnapshot {
+    pub(crate) fn of(queue: &Queue) -> Self {
+        Self {
+            size: queue.size,
+            ready: queue.ready,
+            desc_table: queue.desc_table.0,
+            avail_ring: queue.avail_ring.0,
+            used_ring: queue.used_ring.0,
+        }
+    }
+
+    /// The queue again, its device's indices at the used ring's.
+    pub(crate) fn queue(&self, max_size: u16, mem: &GuestMemoryMmap) -> Queue {
+        let mut queue = Queue::new(max_size);
+        queue.size = self.size;
+        queue.ready = self.ready;
+        queue.desc_table = GuestAddress(self.desc_table);
+        queue.avail_ring = GuestAddress(self.avail_ring);
+        queue.used_ring = GuestAddress(self.used_ring);
+        if self.ready {
+            let used: u16 = mem
+                .read_obj(GuestAddress(self.used_ring + 2))
+                .unwrap_or_default();
+            queue.next_avail = Wrapping(used);
+            queue.next_used = Wrapping(used);
+        }
+        queue
+    }
+}
+
+/// A transport and its device, as far as a restore needs them.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct TransportSnapshot {
+    pub device_type: u32,
+    pub device_status: u32,
+    pub features_select: u32,
+    pub acked_features_select: u32,
+    pub queue_select: u32,
+    pub config_generation: u32,
+    pub acked_features: u64,
+    pub interrupt_status: u32,
+    /// The queues the device was activated with; none for a device the driver never activated.
+    pub queues: Vec<QueueSnapshot>,
+    /// What the device itself keeps beyond its queues: see [`super::VirtioDevice::snapshot`].
+    pub device: Vec<u8>,
+}
