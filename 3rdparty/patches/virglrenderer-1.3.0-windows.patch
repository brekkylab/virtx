-add_project_arguments('-imacros', meson.current_build_dir() / 'config.h', language : 'c')
+# An MSVC-style driver -- cl or clang-cl -- has no -imacros. Its equivalent is
+# /FI, and without it config.h is never read: the build dies in u_endian.h with
+# both UTIL_ARCH_*_ENDIAN unset, because the flag is merely warned about and
+# config.h is then taken for a source file.
+if cc.get_argument_syntax() == 'msvc'
+   add_project_arguments('/FI' + (meson.current_build_dir() / 'config.h'), language : 'c')
+else
+   add_project_arguments('-imacros', meson.current_build_dir() / 'config.h', language : 'c')
+endif
