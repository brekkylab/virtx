+#ifndef HAVE_EVENTFD_H
+/* Without eventfd (macOS), a socket pair stands in for it: the render server
+ * writes to one end and the sync thread polls and drains the other. The
+ * writing end is kept here as well, to hand to the server and to wake the
+ * sync thread on destroy. SO_NOSIGPIPE makes a write after the reading end is
+ * gone fail with EPIPE instead of raising SIGPIPE.
+ */
+static bool
+proxy_context_create_fence_socket_pair(struct proxy_context *ctx)
+{
+   int fds[2];
+   if (socketpair(AF_UNIX, SOCK_STREAM, 0, fds))
+      return false;
+
+   const int on = 1;
+   for (int i = 0; i < 2; i++) {
+      if (fcntl(fds[i], F_SETFD, FD_CLOEXEC) || fcntl(fds[i], F_SETFL, O_NONBLOCK)) {
+         close(fds[0]);
+         close(fds[1]);
+         return false;
+      }
+   }
+   if (setsockopt(fds[1], SOL_SOCKET, SO_NOSIGPIPE, &on, sizeof(on))) {
+      close(fds[0]);
+      close(fds[1]);
+      return false;
+   }
+
+   ctx->sync_thread.fence_eventfd = fds[0];
+   ctx->sync_thread.fence_notify_fd = fds[1];
+   return true;
+}
+#endif
