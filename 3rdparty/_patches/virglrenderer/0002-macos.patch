index acdd202c..a4b760b6 100644
--- a/src/virglrenderer.c
+++ b/src/virglrenderer.c
@@ -954,7 +954,17 @@ int virgl_renderer_init(void *cookie, int flags, struct virgl_renderer_callbacks
    int ret;
 
    /* VIRGL_RENDERER_THREAD_SYNC is a hint and can be silently ignored */
-   if (!has_eventfd() || getenv("VIRGL_DISABLE_MT"))
+   bool can_thread_sync = has_eventfd();
+#if defined(ENABLE_RENDER_SERVER) && !defined(HAVE_EVENTFD_H)
