     pub(crate) fn poll_at(&self, cx: &mut Context) -> PollAt {
         // The logic here mirrors the beginning of dispatch() closely.
+        #[cfg(feature = "socket-tcp-pause-synack")]
+        if self.state == State::SynReceived && self.synack_paused {
+            // dispatch() sends nothing while the SYN|ACK is paused, but still times it out.
+            return match (self.remote_last_ts, self.timeout) {
+                (Some(last), Some(timeout)) => PollAt::Time(last + timeout),
+                _ => PollAt::Ingress,
+            };
+        }
