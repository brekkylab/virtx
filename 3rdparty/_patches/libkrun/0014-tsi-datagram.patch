From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: khj809 <onsealeatang@gmail.com>
Date: Tue, 24 Nov 2026 13:09:17 +0900
Subject: tsi-datagram: a datagram socket's destinations are put to the policy apart from a stream's connect

## Why virtx needs it

virtx's policy (`virtx-uvm/src/machine/net/policy.rs`) reports each outbound flow of a sandbox on a public network, with its protocol, and limits how many new ones it opens: a stream's `connect` is one connection, while a datagram socket's destinations are counted once each in a window. Asked through `connect` alone, the policy could not tell a TCP connection from a UDP datagram.

## What it changes

`TsiPolicy::datagram`, which defaults to `connect`, is asked for a datagram socket's `connect` and for each `sendto` destination; `connect` is asked for a stream's alone. The muxer tells the two apart by the proxy the request is for.

## When it can go

With the TsiPolicy patch, which it extends.
---
 src/devices/src/virtio/vsock/muxer.rs         | 10 ++++++++--
 src/devices/src/virtio/vsock/policy.rs        |  6 ++++++
 src/devices/src/virtio/vsock/proxy.rs         |  4 ++++
 src/devices/src/virtio/vsock/tsi_dgram/mod.rs |  4 ++++
 4 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/src/devices/src/virtio/vsock/muxer.rs b/src/devices/src/virtio/vsock/muxer.rs
index 1b3a3ec5..93f76315 100644
--- a/src/devices/src/virtio/vsock/muxer.rs
+++ b/src/devices/src/virtio/vsock/muxer.rs
@@ -466,7 +466,13 @@ impl VsockMuxer {
             if let Some(to) = inet(&req.addr)
                 && let Some(policy) = &self.policy
             {
-                match policy.connect(to) {
+                let datagram = (self.proxy_map.read().unwrap().get(&id))
+                    .is_some_and(|proxy| proxy.lock().unwrap().is_datagram());
+                let to = match datagram {
+                    true => policy.datagram(to),
+                    false => policy.connect(to),
+                };
+                match to {
                     Some(to) => req.addr = storage(to),
                     None => {
                         debug!("proxy connect request: id={id} refused by policy");
@@ -534,7 +540,7 @@ impl VsockMuxer {
             if let Some(to) = inet(&req.addr)
                 && let Some(policy) = &self.policy
             {
-                match policy.connect(to) {
+                match policy.datagram(to) {
                     Some(to) => req.addr = storage(to),
                     None => {
                         debug!("new DGRAM sendto addr: id={id} refused by policy");
diff --git a/src/devices/src/virtio/vsock/policy.rs b/src/devices/src/virtio/vsock/policy.rs
index 758e85e2..1d1470b6 100644
--- a/src/devices/src/virtio/vsock/policy.rs
+++ b/src/devices/src/virtio/vsock/policy.rs
@@ -22,6 +22,12 @@ pub trait TsiPolicy: Send + Sync {
     /// is dropped, the way one sent into a network that does not route it would be.
     fn connect(&self, to: SocketAddr) -> Option<SocketAddr>;
 
+    /// As [`connect`](Self::connect), for a datagram socket's: its `connect` and each
+    /// destination it sends to. Asked apart, for a policy that tells streams from datagrams.
+    fn datagram(&self, to: SocketAddr) -> Option<SocketAddr> {
+        self.connect(to)
+    }
+
     /// Where on the host a guest's `listen` at `at` binds, or `None` to keep it inside the
     /// guest. `None` is not a failure: the guest kernel takes `EPERM` as a sign to listen on
     /// its own stack instead, so the socket still works for the guest and only the host
diff --git a/src/devices/src/virtio/vsock/proxy.rs b/src/devices/src/virtio/vsock/proxy.rs
index 9044f99a..85d6358b 100644
--- a/src/devices/src/virtio/vsock/proxy.rs
+++ b/src/devices/src/virtio/vsock/proxy.rs
@@ -95,6 +95,10 @@ pub trait Proxy: Send + AsRawFd {
     fn getpeername(&mut self, pkt: &VsockPacket);
     fn sendmsg(&mut self, pkt: &VsockPacket) -> ProxyUpdate;
     fn sendto_addr(&mut self, req: TsiSendtoAddr) -> ProxyUpdate;
+    /// Whether it is a datagram socket's, whose destinations a policy is asked of as such.
+    fn is_datagram(&self) -> bool {
+        false
+    }
     /// Forget where datagrams were going, so that data following a destination a policy
     /// refused is dropped rather than sent wherever the one before it went.
     fn refuse_sendto(&mut self) {}
diff --git a/src/devices/src/virtio/vsock/tsi_dgram/mod.rs b/src/devices/src/virtio/vsock/tsi_dgram/mod.rs
index 0ece3eb7..9d1337f2 100644
--- a/src/devices/src/virtio/vsock/tsi_dgram/mod.rs
+++ b/src/devices/src/virtio/vsock/tsi_dgram/mod.rs
@@ -108,6 +108,10 @@ impl TsiDgramProxy {
 }
 
 impl Proxy for TsiDgramProxy {
+    fn is_datagram(&self) -> bool {
+        true
+    }
+
     fn id(&self) -> u64 {
         self.id
     }
