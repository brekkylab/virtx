diff --git a/src/venus/vkr_physical_device.c b/src/venus/vkr_physical_device.c
index bc38754..9c355ab 100644
--- a/src/venus/vkr_physical_device.c
+++ b/src/venus/vkr_physical_device.c
@@ -5,6 +5,8 @@
 
 #include "vkr_physical_device.h"
 
+#include <stdlib.h>
+
 #include "vn_protocol_renderer_device.h"
 
 #include "vkr_context.h"
@@ -165,6 +167,40 @@ vkr_physical_device_init_id_properties(struct vkr_physical_device *physical_dev)
    vk->GetPhysicalDeviceProperties2(handle, &props2);
 }
 
+/* The most memory any heap is reported to hold, in bytes, or 0 for no limit.
+ *
+ * Set by the embedder in VKR_HEAP_SIZE_MAX when what it can back is less than
+ * what the host device has -- a guest that maps its host-visible memory
+ * through a window of guest-physical addresses can hold no more than that
+ * window, whatever the device underneath reports. Reporting the smaller size
+ * is what lets a guest program size itself to what it can have, rather than
+ * find out at the vkMapMemory that fails.
+ */
+static VkDeviceSize
+vkr_heap_size_max(void)
+{
+   static VkDeviceSize max;
+   static bool read;
+   if (!read) {
+      const char *env = getenv("VKR_HEAP_SIZE_MAX");
+      max = env ? strtoull(env, NULL, 0) : 0;
+      read = true;
+   }
+   return max;
+}
+
+static void
+vkr_clamp_memory_heaps(VkPhysicalDeviceMemoryProperties *props)
+{
+   const VkDeviceSize max = vkr_heap_size_max();
+   if (!max)
+      return;
+   for (uint32_t i = 0; i < props->memoryHeapCount; i++) {
+      if (props->memoryHeaps[i].size > max)
+         props->memoryHeaps[i].size = max;
+   }
+}
+
 static void
 vkr_physical_device_init_memory_properties(struct vkr_physical_device *physical_dev)
 {
@@ -172,6 +208,7 @@ vkr_physical_device_init_memory_properties(struct vkr_physical_device *physical_
 
    VkPhysicalDevice handle = physical_dev->base.handle.physical_device;
    vk->GetPhysicalDeviceMemoryProperties(handle, &physical_dev->memory_properties);
+   vkr_clamp_memory_heaps(&physical_dev->memory_properties);
 
    /* XXX When a VkMemoryType has VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT, we
     * assume any VkDeviceMemory with the memory type can be made external and
@@ -725,6 +762,19 @@ vkr_dispatch_vkGetPhysicalDeviceMemoryProperties2(
       vn_replace_vkGetPhysicalDeviceMemoryProperties2_args_handle(args);
       vk->GetPhysicalDeviceMemoryProperties2(args->physicalDevice,
                                              args->pMemoryProperties);
+      vkr_clamp_memory_heaps(&args->pMemoryProperties->memoryProperties);
+
+      /* A budget is at most the heap it is of. */
+      const VkDeviceSize max = vkr_heap_size_max();
+      for (VkBaseOutStructure *s = args->pMemoryProperties->pNext; max && s; s = s->pNext) {
+         if (s->sType != VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_BUDGET_PROPERTIES_EXT)
+            continue;
+         VkPhysicalDeviceMemoryBudgetPropertiesEXT *budget = (void *)s;
+         for (uint32_t i = 0; i < VK_MAX_MEMORY_HEAPS; i++) {
+            if (budget->heapBudget[i] > max)
+               budget->heapBudget[i] = max;
+         }
+      }
    }
 }
 
