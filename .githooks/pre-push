#!/usr/bin/env bash
# Installed by `git config core.hooksPath .githooks`. Runs the gate in AGENTS.md before anything
# leaves the machine: `cargo xtask check`, which checks the client always and the servers once
# `cargo xtask init` has run. The bindings' suites are not run here; they need a built library
# and take minutes.
#
# SKIP_HOOKS=1 git push ...   skips it once.
set -euo pipefail

if [[ "${SKIP_HOOKS:-}" == "1" ]]; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"
cargo xtask check
