new file mode 100644
index 00000000..8ace270e
--- /dev/null
+++ b/src/libkrun/src/vmm/snapshot.rs
@@ -0,0 +1,373 @@
+//! A paused machine written to a directory, and read back to restore it in a fresh process on
+//! the same host: KVM x86_64 only.
+//!
+//! ```text
+//! <dir>/state    the vCPUs, the VM's interrupt controllers and clock, the memory's layout and
+//!                every virtio transport, in the order the devices were attached
+//! <dir>/memory   the guest's RAM, region after region, sparse where a page is zero
+//! ```
+//!
+//! A restore maps `memory` privately over the guest's RAM, so pages are read from the file as
+//! the guest touches them and copied only when it writes them. A snapshot is a host's own: its
+//! vCPU state names the host's CPU features, and nothing here checks them on another.
+
+use std::fs::{self, File};
+use std::io::{self, Write};
+use std::os::unix::fs::FileExt;
+use std::os::unix::io::AsRawFd;
+use std::path::Path;
+
+use devices::virtio::snapshot::{QueueSnapshot, TransportSnapshot};
+use vm_memory::{GuestMemoryBackend, GuestMemoryMmap, GuestMemoryRegion};
+
+use super::vstate::{VcpuState, VmState};
+
+const MAGIC: &[u8; 8] = b"VXSNAP01";
+const PAGE: usize = 4096;
+
+/// A machine's state, without its memory.
+pub(crate) struct Snapshot {
+    pub(crate) vcpus: Vec<VcpuState>,
+    pub(crate) vm: VmState,
+    /// Each RAM region's guest address and length, in the order `memory` holds them.
+    pub(crate) regions: Vec<(u64, u64)>,
+    pub(crate) transports: Vec<TransportSnapshot>,
+}
+
+impl Snapshot {
+    pub(crate) fn write(&self, dir: &Path, mem: &GuestMemoryMmap) -> Result<(), String> {
+        fs::create_dir_all(dir).map_err(|e| format!("making {}: {e}", dir.display()))?;
+        write_memory(&dir.join("memory"), mem)
+            .map_err(|e| format!("writing the guest's memory: {e}"))?;
+
+        let mut out = Writer::default();
+        out.bytes(MAGIC);
+        out.u64(self.vcpus.len() as u64);
+        for vcpu in &self.vcpus {
+            vcpu.write(&mut out);
+        }
+        self.vm.write(&mut out);
+        out.u64(self.regions.len() as u64);
+        for (addr, len) in &self.regions {
+            out.u64(*addr);
+            out.u64(*len);
+        }
+        out.u64(self.transports.len() as u64);
+        for transport in &self.transports {
+            write_transport(&mut out, transport);
+        }
+        let path = dir.join("state");
+        let mut file = File::create(&path).map_err(|e| format!("{}: {e}", path.display()))?;
+        file.write_all(&out.0)
+            .map_err(|e| format!("{}: {e}", path.display()))
+    }
+
+    pub(crate) fn read(dir: &Path) -> Result<Self, String> {
+        let path = dir.join("state");
+        let bytes = fs::read(&path).map_err(|e| format!("{}: {e}", path.display()))?;
+        let mut input = Reader(&bytes);
+        if input.bytes()? != MAGIC {
+            return Err(format!("{} is not a snapshot this libkrun reads", path.display()));
+        }
+        let vcpus = (0..input.u64()?)
+            .map(|_| VcpuState::read(&mut input))
+            .collect::<Result<_, _>>()?;
+        let vm = VmState::read(&mut input)?;
+        let regions = (0..input.u64()?)
+            .map(|_| Ok((input.u64()?, input.u64()?)))
+            .collect::<Result<_, String>>()?;
+        let transports = (0..input.u64()?)
+            .map(|_| read_transport(&mut input))
+            .collect::<Result<_, _>>()?;
+        Ok(Self {
+            vcpus,
+            vm,
+            regions,
+            transports,
+        })
+    }
+}
+
+/// Each region's guest address and length, as a snapshot lays out its memory.
+pub(crate) fn regions(mem: &GuestMemoryMmap) -> Vec<(u64, u64)> {
+    mem.iter()
+        .map(|region| (region.start_addr().0, region.len()))
+        .collect()
+}
+
+/// The guest's RAM into `path`, region after region, leaving a hole for every zero page.
+fn write_memory(path: &Path, mem: &GuestMemoryMmap) -> io::Result<()> {
+    let file = File::create(path)?;
+    let mut offset = 0u64;
+    for region in mem.iter() {
+        let len = region.len() as usize;
+        // SAFETY: the region's own mapping, `len` bytes long, which the paused guest and the
+        // quiesced devices do not write while it is read.
+        let bytes = unsafe { std::slice::from_raw_parts(region.as_ptr(), len) };
+        let mut page = 0;
+        while page < len {
+            let end = (page + PAGE).min(len);
+            // Runs of non-zero pages are written at once.
+            if bytes[page..end].iter().all(|b| *b == 0) {
+                page = end;
+                continue;
+            }
+            let mut run_end = end;
+            while run_end < len {
+                let next = (run_end + PAGE).min(len);
+                if bytes[run_end..next].iter().all(|b| *b == 0) {
+                    break;
+                }
+                run_end = next;
+            }
+            file.write_all_at(&bytes[page..run_end], offset + page as u64)?;
+            page = run_end;
+        }
+        offset += len as u64;
+    }
+    file.set_len(offset)?;
+    Ok(())
+}
+
+/// Maps `dir/memory` privately over the guest's RAM, which must be laid out as `regions` says.
+/// Nothing may have been written to RAM before, since this replaces it.
+pub(crate) fn map_memory(
+    dir: &Path,
+    mem: &GuestMemoryMmap,
+    regions: &[(u64, u64)],
+) -> Result<(), String> {
+    let laid_out = self::regions(mem);
+    if laid_out != regions {
+        return Err(format!(
+            "the guest's memory is laid out as {laid_out:x?}, the snapshot's as {regions:x?}"
+        ));
+    }
+    let path = dir.join("memory");
+    let file = File::open(&path).map_err(|e| format!("{}: {e}", path.display()))?;
+    // Read rather than mapped: under nested virtualization each 4 KiB page of a file mapping
+    // the guest touches is a fault through both hypervisors, where huge anonymous pages are few.
+    if std::env::var_os("VIRTX_SPIKE_MAPPED").is_none() {
+        return read_memory(&file, mem).map_err(|e| format!("reading {}: {e}", path.display()));
+    }
+    let mut offset = 0u64;
+    for region in mem.iter() {
+        // SAFETY: replaces the region's own mapping, at its own address and length, with the
+        // file's pages; the guest has not run and nothing holds a reference into it.
+        let mapped = unsafe {
+            libc::mmap(
+                region.as_ptr().cast(),
+                region.len() as usize,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_PRIVATE | libc::MAP_FIXED | libc::MAP_NORESERVE,
+                file.as_raw_fd(),
+                offset as libc::off_t,
+            )
+        };
+        if mapped == libc::MAP_FAILED {
+            return Err(format!(
+                "mapping {} over the guest's memory: {}",
+                path.display(),
+                io::Error::last_os_error()
+            ));
+        }
+        offset += region.len();
+    }
+    Ok(())
+}
+
+/// Spike: the file's data read into the guest's own anonymous RAM, asked to be backed by huge
+/// pages, rather than mapped: what is not data stays the zero it already is.
+fn read_memory(file: &File, mem: &GuestMemoryMmap) -> io::Result<()> {
+    // The file's data extents, each with where it goes in the guest's RAM.
+    let mut extents: Vec<(u64, usize, usize)> = Vec::new();
+    let mut offset = 0i64;
+    for region in mem.iter() {
+        let len = region.len() as i64;
+        // SAFETY: the region's own mapping; the advice keeps its contents.
+        unsafe { libc::madvise(region.as_ptr().cast(), len as usize, libc::MADV_HUGEPAGE) };
+        let end = offset + len;
+        let mut at = offset;
+        while at < end {
+            // SAFETY: plain calls on an open file.
+            let data = unsafe { libc::lseek(file.as_raw_fd(), at, libc::SEEK_DATA) };
+            if data < 0 || data >= end {
+                break;
+            }
+            let hole = unsafe { libc::lseek(file.as_raw_fd(), data, libc::SEEK_HOLE) }.min(end);
+            // Split into pieces no larger than 8 MiB, so that threads share the work.
+            let mut piece = data;
+            while piece < hole {
+                let next = (piece + (8 << 20)).min(hole);
+                let host = region.as_ptr() as usize + (piece - offset) as usize;
+                extents.push((piece as u64, host, (next - piece) as usize));
+                piece = next;
+            }
+            at = hole;
+        }
+        offset = end;
+    }
+    let threads: usize = std::env::var("VIRTX_SPIKE_READERS")
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(4);
+    let next = std::sync::atomic::AtomicUsize::new(0);
+    std::thread::scope(|scope| {
+        let workers: Vec<_> = (0..threads)
+            .map(|_| {
+                scope.spawn(|| -> io::Result<()> {
+                    loop {
+                        let i = next.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+                        let Some(&(at, host, len)) = extents.get(i) else {
+                            return Ok(());
+                        };
+                        // SAFETY: within the guest's RAM, a piece no other thread writes.
+                        let into = unsafe { std::slice::from_raw_parts_mut(host as *mut u8, len) };
+                        file.read_exact_at(into, at)?;
+                    }
+                })
+            })
+            .collect();
+        workers
+            .into_iter()
+            .try_for_each(|worker| worker.join().unwrap())
+    })
+}
+
+fn write_transport(out: &mut Writer, t: &TransportSnapshot) {
+    out.u64(t.device_type.into());
+    out.u64(t.device_status.into());
+    out.u64(t.features_select.into());
+    out.u64(t.acked_features_select.into());
+    out.u64(t.queue_select.into());
+    out.u64(t.config_generation.into());
+    out.u64(t.acked_features);
+    out.u64(t.interrupt_status.into());
+    out.u64(t.queues.len() as u64);
+    for q in &t.queues {
+        out.u64(q.size.into());
+        out.u64(q.ready.into());
+        out.u64(q.desc_table);
+        out.u64(q.avail_ring);
+        out.u64(q.used_ring);
+    }
+    out.bytes(&t.device);
+}
+
+fn read_transport(input: &mut Reader) -> Result<TransportSnapshot, String> {
+    let u32_of = |v: u64| u32::try_from(v).map_err(|_| format!("{v} is not a u32"));
+    let device_type = u32_of(input.u64()?)?;
+    let device_status = u32_of(input.u64()?)?;
+    let features_select = u32_of(input.u64()?)?;
+    let acked_features_select = u32_of(input.u64()?)?;
+    let queue_select = u32_of(input.u64()?)?;
+    let config_generation = u32_of(input.u64()?)?;
+    let acked_features = input.u64()?;
+    let interrupt_status = u32_of(input.u64()?)?;
+    let queues = (0..input.u64()?)
+        .map(|_| {
+            Ok(QueueSnapshot {
+                size: input.u64()? as u16,
+                ready: input.u64()? != 0,
+                desc_table: input.u64()?,
+                avail_ring: input.u64()?,
+                used_ring: input.u64()?,
+            })
+        })
+        .collect::<Result<_, String>>()?;
+    let device = input.bytes()?.to_vec();
+    Ok(TransportSnapshot {
+        device_type,
+        device_status,
+        features_select,
+        acked_features_select,
+        queue_select,
+        config_generation,
+        acked_features,
+        interrupt_status,
+        queues,
+        device,
+    })
+}
+
+/// Length-prefixed fields, in the host's own byte order and layout: a snapshot is read only
+/// where it was written.
+#[derive(Default)]
+pub(crate) struct Writer(Vec<u8>);
+
+impl Writer {
+    pub(crate) fn bytes(&mut self, bytes: &[u8]) {
+        self.0.extend((bytes.len() as u64).to_le_bytes());
+        self.0.extend(bytes);
+    }
+
+    pub(crate) fn u64(&mut self, v: u64) {
+        self.0.extend(v.to_le_bytes());
+    }
+
+    /// A KVM structure, as its bytes.
+    pub(crate) fn pod<T>(&mut self, v: &T) {
+        // SAFETY: KVM's structures are plain data; any of their bytes may be read.
+        let bytes = unsafe {
+            std::slice::from_raw_parts((v as *const T).cast::<u8>(), std::mem::size_of::<T>())
+        };
+        self.bytes(bytes);
+    }
+
+    pub(crate) fn slice<T>(&mut self, v: &[T]) {
+        // SAFETY: as `pod`'s, for each element.
+        let bytes = unsafe {
+            std::slice::from_raw_parts(v.as_ptr().cast::<u8>(), std::mem::size_of_val(v))
+        };
+        self.bytes(bytes);
+    }
+}
+
+pub(crate) struct Reader<'a>(&'a [u8]);
+
+impl<'a> Reader<'a> {
+    pub(crate) fn bytes(&mut self) -> Result<&'a [u8], String> {
+        let len = self.u64()? as usize;
+        if self.0.len() < len {
+            return Err("the snapshot's state ends early".into());
+        }
+        let (bytes, rest) = self.0.split_at(len);
+        self.0 = rest;
+        Ok(bytes)
+    }
+
+    pub(crate) fn u64(&mut self) -> Result<u64, String> {
+        if self.0.len() < 8 {
+            return Err("the snapshot's state ends early".into());
+        }
+        let (bytes, rest) = self.0.split_at(8);
+        self.0 = rest;
+        Ok(u64::from_le_bytes(bytes.try_into().unwrap()))
+    }
+
+    pub(crate) fn pod<T>(&mut self) -> Result<T, String> {
+        let bytes = self.bytes()?;
+        if bytes.len() != std::mem::size_of::<T>() {
+            return Err(format!(
+                "{} bytes where a {} takes {}",
+                bytes.len(),
+                std::any::type_name::<T>(),
+                std::mem::size_of::<T>()
+            ));
+        }
+        // SAFETY: KVM's structures are plain data, valid for any bytes of their size.
+        Ok(unsafe { std::ptr::read_unaligned(bytes.as_ptr().cast::<T>()) })
+    }
+
+    pub(crate) fn slice<T>(&mut self) -> Result<Vec<T>, String> {
+        let bytes = self.bytes()?;
+        let size = std::mem::size_of::<T>();
+        if bytes.len() % size != 0 {
+            return Err(format!("{} bytes of {}", bytes.len(), std::any::type_name::<T>()));
+        }
+        Ok(bytes
+            .chunks_exact(size)
+            // SAFETY: as `pod`'s, for each element.
+            .map(|chunk| unsafe { std::ptr::read_unaligned(chunk.as_ptr().cast::<T>()) })
+            .collect())
+    }
+}
