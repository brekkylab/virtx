# The directory under /alib build.sh fills, and the image it runs in: one per C library a
# program in an image may be built against, glibc at 2.28 so an image as old as that loads it.
# Docker Hub's images through mirror.gcr.io, which has no rate limit for an anonymous pull.
musl mirror.gcr.io/library/alpine:3.22
glibc quay.io/pypa/manylinux_2_28_{arch}:2026.11.07-1
