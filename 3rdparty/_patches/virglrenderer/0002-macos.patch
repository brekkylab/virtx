+       !(flags & VIRGL_RENDERER_DRM))
+      can_thread_sync = true;
+#endif
+   if (!can_thread_sync || getenv("VIRGL_DISABLE_MT"))
       flags &= ~VIRGL_RENDERER_THREAD_SYNC;
 
    if (state.client_initialized && (state.cookie != cookie ||
